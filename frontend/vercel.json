      {
        "protocol": "https",
        "hostname": "www.axis-y.com"
      },
      {
        "protocol": "https",
        "hostname": "www.cerave.com"
      },
      {
        "protocol": "https",
        "hostname": "www.cosrx.com"
      },
      {
        "protocol": "https",
        "hostname": "www.laroche-posay.sg"
      },
      {
        "protocol": "https",
        "hostname": "www.skin1004.com"
      }
    ]
  },
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
